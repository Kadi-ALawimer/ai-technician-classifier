# Copy this file to ".env" if you need to point the frontend at a backend
# running somewhere other than http://localhost:8000.
#
# IMPORTANT: Never put an AI provider API key here. Vite exposes any
# VITE_-prefixed variable to the browser bundle, so secrets do NOT belong
# in the frontend. The Gemini/OpenAI API key lives ONLY in backend/.env.

VITE_API_BASE_URL=http://localhost:8000
