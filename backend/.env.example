# Copy this file to ".env" and fill in real values as needed.
# ".env" itself is git-ignored and must NEVER be committed.

# Which AI provider to use: mock | gemini | openai
AI_PROVIDER=mock

# --- Gemini (only needed if AI_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI (only needed if AI_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Database ---
DATABASE_URL=sqlite:///./data/app.db

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
